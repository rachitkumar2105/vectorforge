# Copy to .env and fill in. Never commit .env.
# Engine (required: the service refuses to start without an admin key of >= 32 chars)
VECTORFORGE_ADMIN_KEY=replace-with-output-of-openssl-rand-hex-32
# Optional read-only key, scoped to VECTORFORGE_DEMO_COLLECTION
VECTORFORGE_DEMO_KEY=replace-with-a-different-random-value
VECTORFORGE_DEMO_COLLECTION=demo
VECTORFORGE_DATA_DIR=./data
# Exact origins, comma separated. No wildcard.
VECTORFORGE_CORS_ORIGINS=http://localhost:3000
VECTORFORGE_ENV=development

# Site (server-only). Behind a proxy other than Vercel, name the header it sets with the real
# client address; otherwise all demo visitors share one rate-limit bucket.
VECTORFORGE_ENGINE_URL=https://your-engine.example
# VECTORFORGE_DEMO_KEY is the same value as above, set on the site host as a server-side variable.
DEMO_TRUSTED_IP_HEADER=
